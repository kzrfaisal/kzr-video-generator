{
  "name": "kzr-video-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first AI video studio for narrated explainers, debates, and social clips",
  "main": "main.ts",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "start": "tsx main.ts",
    "all": "tsx src/features/pipeline/runAll.ts",
    "script": "tsx src/features/scripts/generateScript.ts",
    "thumbnail": "tsx src/features/visuals/generateThumbnail.ts",
    "audio": "tsx src/features/rendering/generateAudio.ts",
    "video": "tsx src/features/rendering/makeVideo.ts",
    "transitions": "tsx src/features/rendering/createTransitions.ts",
    "transition-audio": "tsx src/features/rendering/addTransitionAudio.ts",
    "extract-reel-scripts": "tsx src/features/reels/extractReelScripts.ts",
    "reels": "tsx src/features/reels/makeReels.ts --style=style3",
    "test:domain": "node --import tsx --test src/domain/projects/*.test.ts",
    "test:openai": "node --import tsx --test src/services/openai/*.test.ts",
    "test:pipeline": "node --import tsx --test src/domain/pipeline/*.test.ts",
    "test": "node --import tsx --test src/domain/projects/*.test.ts src/domain/pipeline/*.test.ts src/services/openai/*.test.ts",
    "test:unit": "npm test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run next:build"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "next": "^16.4.3",
    "openai": "^7.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
