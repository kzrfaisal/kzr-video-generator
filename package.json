{
  "name": "kzr-video-generator",
  "version": "1.0.0",
  "description": "Debate video generator",
  "main": "main.ts",
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "start": "tsx main.ts",
    "all": "tsx src/runAll.ts",
    "script": "tsx src/generateScript.ts",
    "thumbnail": "tsx src/generateThumbnail.ts",
    "audio": "tsx src/generateAudio.ts",
    "video": "tsx src/makeVideo.ts",
    "transitions": "tsx src/createTransitions.ts",
    "transition-audio": "tsx src/addTransitionAudio.ts",
    "extract-reel-scripts": "tsx src/extractReelScripts.ts",
    "reels": "tsx src/makeReels.ts --style=style3",
    "test:domain": "tsx --test src/domain/projects/*.test.ts",
    "test:openai": "tsx --test src/services/openai/*.test.ts",
    "test:unit": "tsx --test src/domain/projects/*.test.ts src/services/openai/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "next": "^16.2.11",
    "openai": "^4.97.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
